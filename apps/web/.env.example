# Copy to apps/web/.env and fill in.
# Neon / Postgres connection string (run db/schema.sql against it first)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Random secret for Auth.js sessions, e.g. `openssl rand -base64 32`
AUTH_SECRET=
# Public URL of the web app
AUTH_URL=http://localhost:4000
